# Copy to .env and adjust as needed. Every value below has a working default,
# so the app runs with zero configuration out of the box.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Routing provider. Points at the free public OSRM demo server by default.
# Swap to a self-hosted OSRM instance or an OSRM-API-compatible provider
# (e.g. OpenRouteService) if the public server is rate-limited.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10

# Geocoding of the two user-supplied endpoints (not used for station data,
# which is geocoded offline at import time).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-api (assessment project)
NOMINATIM_TIMEOUT_SECONDS=10

# Overpass (OSM), used only offline by `manage.py fetch_highway_exits` to
# build data/highway_exits.csv. Never called at request time.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=fuel-route-api (assessment project)
OVERPASS_TIMEOUT_SECONDS=90

# Vehicle model used by the fuel-stop optimizer.
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10

# How far off the route (miles) a station can sit and still be considered.
CORRIDOR_MILES=5
